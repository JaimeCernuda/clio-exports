      "description": "Execute the following exact Python program using run_code with background=True and label=\"Watch the experiment\". Do not substitute shell execution. The tools/stream/task names are CLIO kernel bindings. Keep outputs in the workspace. Report only the genuine result or launch handle.\n\n\"\"\"Background kernel program: sensor replay, then a numerical source on the same path.\"\"\"\nimport asyncio\nimport json\nimport math\n\nrows = json.loads(open(\"burn.json\", encoding=\"utf-8\").read())\nsensor = await stream.open(\"burn-observations\", columns=[\"local_label\", \"particle_mean_ug_m3\"],\n                           window=18, flush_s=30)\nsimulation = None\ntheta, velocity, simulation_time = 0.1, 0.0, 0.0\nfor i, row in enumerate(rows):\n    await sensor.write(local_label=row[\"local_label\"], particle_mean_ug_m3=row[\"particle_mean_ug_m3\"])\n    if i == 40:\n        simulation = await stream.open(\"pendulum-simulation\", columns=[\"time_s\", \"angle_rad\"],\n                                       window=18, flush_s=30)\n    if simulation is not None:\n        for _ in range(30):\n            acceleration = -9.80665 * math.sin(theta)\n            theta += velocity * 0.01 + 0.5 * acceleration * 0.01**2\n            velocity += 0.5 * (acceleration - 9.80665 * math.sin(theta)) * 0.01\n            simulation_time += 0.01\n        await simulation.write(time_s=round(simulation_time, 3), angle_rad=theta)\n    await task.progress(\"Replaying recorded observations\", done=i+1, total=len(rows))\n    await asyncio.sleep(0.6)\nawait task.notify(\"Sensor replay complete\")\nprint(\"Sensor replay complete\")",
