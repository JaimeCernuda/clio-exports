{
  "name": "clio-composable-ad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "README.md",
    "HANDOFF.md",
    "CLAUDE.md",
    "AGENTS.md",
    "ART-DIRECTION.md",
    "tsconfig.json",
    "package-lock.json",
    "render.mjs",
    "src",
    "scripts",
    "story",
    "tests",
    "public",
    "examples",
    "references",
    "docs",
    "skills"
  ],
  "scripts": {
    "studio": "remotion studio src/index.tsx --port=3370 --no-open",
    "stills": "node render.mjs stills",
    "measure": "node render.mjs stills --scale 1 --frames 0,24,60,96,166,235,300,355,405,440,470,490,510,528,678,758,770,778,786,806,900,1018,1025,1026,1040,1070,1120,1176,1183,1184,1196,1280,1340,1342,1400,1422,1424,1490,1546,1553,1554,1566,1660,1790,1880,1970,2070,2300 --props examples/composable-measure.json",
    "render": "node render.mjs video --scale 1 --concurrency 4 --output out/composable/clio-composable-ad-v12-clean.mp4 && node scripts/finish.mjs",
    "qr": "node scripts/prepare-qr.mjs",
    "review": "tsx scripts/review.ts",
    "review:geometry": "tsx scripts/review.ts --geometry-only",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests render.mjs story examples package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.521",
    "@remotion/cli": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "lucide-react": "1.33.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
