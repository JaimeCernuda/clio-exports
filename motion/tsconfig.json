{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "scripts/review-connected.ts",
    "scripts/review-joins.ts",
    "scripts/measure-study-layout.ts",
    "scripts/measure-study-cursor.ts",
    "scripts/audit-study-plan.ts",
    "scripts/retime-study-captions.ts",
    "scripts/measure-engineering.ts"
  ]
}
