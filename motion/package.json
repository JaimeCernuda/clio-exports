    "@remotion/renderer": "4.0.521",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
