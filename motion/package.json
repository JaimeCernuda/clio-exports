{
  "name": "clio-motion-authoring",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx --port=3347 --no-open",
    "native:dev": "node native/run.mjs dev",
    "native:build": "node native/run.mjs build",
    "native:check": "node native/run.mjs check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/ui.test.tsx tests/render-options.test.mjs tests/native-session.test.ts tests/native-film.test.ts tests/campaign.test.ts tests/ndp-campaigns.test.ts tests/story.test.ts tests/cursor.test.ts tests/vector-chart.test.ts tests/frame-review.test.ts tests/paired-replay.test.ts tests/spotter-intro.test.ts tests/study-replay.test.ts tests/engineering-plan.test.ts tests/engineering-film.test.ts tests/engineering-assembly.test.mjs tests/prompt-morph.test.ts tests/composable-ad.test.ts",
    "format:check": "prettier --check src scripts tests render.mjs examples native/*.ts native/*.tsx native/*.mjs native/*.css native/*.html native/source.json",
    "stills": "node render.mjs stills",
    "promo:stills": "node render.mjs stills --composition ClioNativePromo",
    "promo:render": "node render.mjs video --composition ClioNativePromo --scale 1 --output out/clio-investigation-story.mp4",
    "campaign:pitch": "node render.mjs video --composition NdpClioPitch --scale 1 --output out/ndp-clio-tahoe-v4.mp4",
    "campaign:alta": "node render.mjs video --composition NdpClioAlta --scale 1 --output out/ndp-clio-alta-v2.mp4",
    "campaign:konza": "node render.mjs video --composition NdpClioKonza --scale 1 --output out/ndp-clio-konza-v2.mp4",
    "campaign:inspections": "tsx scripts/render-inspections.ts",
    "campaign:story": "tsx scripts/assemble-story.ts",
    "campaign:social": "node render.mjs video --composition NdpClioSocial --scale 1 --output out/ndp-clio-conversation-social.mp4",
    "render": "node render.mjs video",
    "engineering:measure": "tsx scripts/measure-engineering.ts pointer && tsx scripts/measure-engineering.ts layout",
    "engineering:build": "node native/run.mjs build --profile engineering",
    "engineering:check": "node native/run.mjs check --profile engineering",
    "engineering:native-test": "node --test tests/engineering-browser.test.mjs",
    "engineering:preview": "node scripts/serve-engineering.mjs",
    "engineering:render": "node --max-old-space-size=4096 scripts/render-engineering.mjs full video out/engineering-v2/engineering-demo-clean.mp4",
    "wordle:measure": "tsx scripts/measure-study-cursor.ts",
    "wordle:proof": "node --max-old-space-size=4096 render.mjs video --composition WordleStudyProof --scale 1.5 --concurrency 2 --output out/wordle-study-proof.mp4",
    "wordle:render": "node --max-old-space-size=4096 render.mjs video --composition WordleStudyWalkthrough --scale 1.5 --concurrency 2 --output out/wordle-study-walkthrough.mp4",
    "composable:legacy": "node render.mjs video --composition ClioComposable --scale 1 --concurrency 4 --output out/composable/clio-composable-v1.mp4",
    "composable:render": "node render.mjs video --composition ClioComposableAd --scale 1 --concurrency 4 --output out/composable/clio-composable-ad-v9-clean.mp4 && node scripts/finish-composable-ad.mjs",
    "composable:review": "tsx scripts/review-composable-ad.ts",
    "composable:legacy-review": "tsx scripts/review-composable.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.521",
    "@remotion/cli": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "lucide-react": "1.33.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remend": "1.3.0",
    "remotion": "4.0.521"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsqr": "1.4.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
