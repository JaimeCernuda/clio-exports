e","title":"Read File","state":"succeeded","input":{"_clio_task_description":"Review portable runner for missing imports, path dependencies, and reference-input separation","access_reason":"","filepath":"D:\\CLIO-Develop\\ndp-shareable-20261019\\alta-snowfall-17\\alta_reproducibility\\reproduce.py"},"output":{"content":[],"structuredContent":{"content":"\"\"\"Reproduce the Alta-Collins comparisons offline; Python standard library only.\"\"\"\nimport argparse\nimport hashlib\nimport math\nimport platform\nimport sys\nfrom pathlib import Path\nimport json\n\nPACKAGE = Path(__file__).resolve().parent\nparser = argparse.ArgumentParser(description=__doc__)\nparser.add_argument('--output', type=Path, default=PACKAGE / 'results')\nparser.add_argument('--verify', action='store_true', help='Check bundled reference results')\nargs = parser.parse_args()\nroot = args.output.resolve()\nif root == PACKAGE or PACKAGE / 'data' in (root, *root.parents) or PACKAGE / 'reference_results' in (root, *root.parents):\n    parser.error('Output cannot overwrite the package, sources or reference results')\nroot.mkdir(parents=True, exist_ok=True)\nmanifest = json.loads((PACKAGE / 'manifest.json').read_text(encoding='utf-8'))\nfor relative, expected_hash in manifest.items():\n    actual = hashlib.sha256((PACKAGE / relative).read_bytes()).hexdigest()\n    if actual != expected_hash:\n        raise ValueError('Package integrity check failed: ' + relative)\nprint('PASS: package file SHA-256 integrity')\nhist = PACKAGE / 'data' / 'historical'\nnew = PACKAGE / 'data' / '2023-24'\r\n\nimport csv, json, hashlib\nfrom pathlib import Path\nfrom datetime import datetime, timedelta\nfrom collections import defaultdict, Counter\ngroups=defaultdict(list)\nfor base in (hist,new):\n p=next(base.glob('*.csv'))\n with p.open(newline='') as f:\n  for r in csv.DictReader(f):\n   t=datetime.strptime(r['Time (LST)'],'%Y-%m-%d %H')\n   if t.hour not in (4,16) or t.month not in (10,11,12,1,2,3,4):\n    raise ValueError('Unexpected timestamp: '+str(t))\n   if not math.isfinite(float(r['12 hr Snow (in.)'])) or float(r['12 hr Snow (in.)'])<0:\n    raise ValueError('Invalid snowfall value')\n   year=t.year+(t.month>=10)\n   groups[year].append((t,r['12 hr Snow (in.)'],r['12 hr LPE (in.)']))\nresults=[]\nfor year,rows in sorted(groups.items()):\n start=datetime(year-1,10,1,4); stop=datetime(year,5,1,4)\n expected=set(); t=start\n while t<stop:\n  expected.add(t); t+=timedelta(hours=12)\n times=[r[0] for r in rows]; missing=sorted(expected-set(times)); extra=sorted(set(times)-expected)\n vals=[float(r[1]) for r in rows]\n result=dict(end_year=year,winter=f'{year-1}-{str(year)[2:]}',snowfall_in=round(sum(vals),2),rows=len(rows),expected=len(expected),missing=len(missing),duplicates=len(times)-len(set(times)),extra=len(extra),minimum=min(vals))\n if result['duplicates'] or result['extra']:\n  raise ValueError('Duplicate or out-of-window records')\n results.append(result)\n(root/'coverage.json').write_text(json.dumps(results,indent=2))\nimport statistics as st\nhistoric=[r for r in results if r['end_year']<2024]\ncomplete=[r for r in historic if r['missing']==0]\ntarget=results[-1]['snowfall_in']\nfor r in results:\n y=r['end_year']\n common=[x for x in groups[y] if x[0]>=datetime(y-1,11,1)]\n r['nov_apr_in']=round(sum(float(x[1]) for x in common),2)\n r['oct_in']=round(r['snowfall_in']-r['nov_apr_in'],2)\n r['coverage']='2023-24' if y==2024 else ('Historical: missing October data' if r['missing'] else 'Historical: complete')\n r['label']=r['winter']+(' *' if r['missing'] else '')\n assert len(common)==(datetime(y,5,1)-datetime(y-1,11,1)).days*2\n\ndef stats(vals,t):\n return dict(n=len(vals),mean=st.mean(vals),median=st.median(vals),sd=st.stdev(vals),target=t,difference=t-st.mean(vals),pct_above_mean=100*(t/st.mean(vals)-1),higher=sum(v>t for v in vals),lower=sum(v<t for v in vals),rank_with_target=1+sum(v>t for v in vals),fraction_lower=sum(v<t for v in vals)/len(vals),z=(t-st.mean(vals))/st.stdev(vals))\nsummary={'complete_oct_apr':stats([r['snowfall_in'] for r in complete],target),'available_oct_apr':stats([r['snowfall_in'] for r in historic],target),'common_nov_apr':stats([r['nov_apr_in'] for r in historic],results[-1]['nov_apr_in'])}\nwith (root/'alta_seasonal_comparison.csv').open('w',newline='') as f:\n w=csv.DictWriter(f,fieldnames=list(results[0]));w.writeheader();w.writerows(results)\n(root/'seasonal_summary.json').write_text(json.dumps(summary,indent=2))\nimport calendar\r\ninputs=[next(hist.glob(\"*.csv\")),next(new.glob(\"*.csv\"))]\ngroups=defaultdict(list)\nfor p in inputs:\n with p.open(newline='') as f:\n  for r in csv.DictReader(f):\n   t=datetime.strptime(r['Time (LST)'],'%Y-%m-%d %H')\n   groups[t.year+(t.month>=10),t.month].append((t,float(r['12 hr Snow (in.)'])))\nmonths=[10,11,12,1,2,3,4]; raw=[]\ncomplete_years={int(r['end_year']) for r in csv.DictReader((root/'alta_seasonal_comparison.csv').open()) if r['missing']=='0'}\nfor y in range(2000,2025):\n for order,m in enumerate(months,1):\n  obs=groups[y,m]; expected=2*calendar.monthrange(y-(m>=10),m)[1]\n  assert len(obs)==len(set(t for t,v in obs))\n  good=len(obs)==expected\n  raw.append(dict(winter=f'{y-1}-{str(y)[2:]}',end_year=y,month=calendar.month_abbr[m],month_order=order,snowfall_in=round(sum(v for t,v in obs),2) if good else None,available_sum_in=round(sum(v for t,v in obs),2),missing_periods=expected-len(obs),complete_month=good))\ndef write(name,rows):\n with (root/name).open('w',newline='') as f:\n  w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)\nwrite('alta_monthly_totals.csv',raw)\nsummary=[]\nfor cohort in ['matched17','available']:\n for order,m in enumerate(months,1):\n  hist=[r['snowfall_in'] for r in raw if r['end_year']<2024 and r['month_order']==order and r['complete_month'] and (cohort=='available' or r['end_year'] in complete_years)]\n  target=next(r['snowfall_in'] for r in raw if r['end_year']==2024 and r['month_order']==order)\n  q=st.quantiles(hist,n=4,method='inclusive'); mean=st.mean(hist); diff=target-mean\n  row=dict(cohort=cohort,month=calendar.month_abbr[m],month_order=order,target_in=target,mean_in=round(mean,4),median_in=st.median(hist),q25_in=q[0],q75_in=q[2],min_in=min(hist),max_in=max(hist),anomaly_in=round(diff,4),anomaly_pct=round(100*diff/mean,2),n_history=len(hist),rank=1+sum(v>target for v in hist),rank_of=len(hist)+1,direction='Above mean' if diff>=0 else 'Below mean')\n  summary.append(row)\nwrite('alta_monthly_comparison.csv',summary)\nassert sum(r['target_in'] for r in summary if r['cohort']=='matched17')==635.5\n\r\nmatched=[r for r in summary if r['cohort']=='matched17']\njan_mar=sum(r['anomaly_in'] for r in matched if r['month'] in ('Jan','Feb','Mar'))\nnet=sum(r['anomaly_in'] for r in matched)\ncontributions={'jan_mar_surplus_in':jan_mar,'other_months_net_in':net-jan_mar,'seasonal_net_in':net,'monthly_means_add_to_seasonal_mean':True}\n(root/'monthly_contributions.json').write_text(json.dumps(contributions,indent=2),encoding='utf-8')\nchecks={}\nif args.verify:\n    for name in ('alta_seasonal_comparison.csv','alta_monthly_totals.csv','alta_monthly_comparison.csv'):\n        actual=(root/name).read_bytes()\n        expected=(PACKAGE/'reference_results'/name).read_bytes()\n        if actual != expected:\n            raise ValueError('Reference CSV mismatch: '+name)\n        checks[name]={'status':'PASS','comparison':'byte-for-byte','sha256':hashlib.sha256(actual).hexdigest()}\n    actual=json.loads((root/'seasonal_summary.json').read_text())\n    expected=json.loads((PACKAGE/'reference_results/seasonal_summary.json').read_text())\n    if actual != expected:\n        raise ValueError('Seasonal summary mismatch')\n    checks['seasonal_summary.json']={'status':'PASS','comparison':'parsed JSON equality'}\n    print('PASS: 3 reference CSVs are byte-identical; seasonal summary JSON equal')\nreport={'status':'PASS','reference_verification_requested':args.verify,