nerate a new figure based on the current specifications by removing unnecessary titles and creating a correlation list with an inline table using Altair. I need to organize the bottom values with correlation coefficients, ensuring they match up correctly in rows.","source":"provider","provider_source":"model","reasoning_source":"provider_field","default_collapsed":true,"agent_id":"main","sequence":19,"stream_source":"live","channel":"provider_thinking:model:provider_field"},{"id":"live_call_683101c63b02_call","type":"tool","tool_id":"call_683101c63b02","agent_id":"main","sequence":20,"stream_source":"live"},{"id":"live_call_2379301f5aac_call","type":"tool","tool_id":"call_2379301f5aac","agent_id":"main","sequence":22,"stream_source":"live"},{"id":"live_call_6e32e81ea85c_call","type":"tool","tool_id":"call_6e32e81ea85c","agent_id":"main","sequence":24,"stream_source":"live"},{"id":"live_call_453a8e12042b_call","type":"tool","tool_id":"call_453a8e12042b","agent_id":"main","sequence":25,"stream_source":"live"},{"id":"live_call_92316dbb3485_call","type":"tool","tool_id":"call_92316dbb3485","agent_id":"main","sequence":28,"stream_source":"live"},{"id":"live_call_88bcdb9ac6d1_call","type":"tool","tool_id":"call_88bcdb9ac6d1","agent_id":"main","sequence":30,"stream_source":"live"},{"id":"live_call_da919f8e67c4_call","type":"tool","tool_id":"call_da919f8e67c4","agent_id":"main","sequence":31,"stream_source":"live"},{"id":"live_call_c8843d3e7d5e_call","type":"tool","tool_id":"call_c8843d3e7d5e","agent_id":"main","sequence":34,"stream_source":"live"},{"id":"live_call_2132e2e0b7cc_call","type":"tool","tool_id":"call_2132e2e0b7cc","agent_id":"main","sequence":35,"stream_source":"live"},{"id":"live_call_0ba8442e9388_call","type":"tool","tool_id":"call_0ba8442e9388","agent_id":"main","sequence":38,"stream_source":"live"},{"id":"live_call_2a46b98cef67_call","type":"tool","tool_id":"call_2a46b98cef67","agent_id":"main","sequence":39,"stream_source":"live"},{"id":"live_call_8be71311