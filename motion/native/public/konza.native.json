bient air. WindObserver II, LI-840A and Picarro have no April 15 records. Unknown clock synchronization and inlet delays prevent a defensible lag, plume path, emissions factor or flux.","component":"clio.callout.v1","id":"limits","severity":"warning","title":"What these sensors cannot establish"}],"controls":[{"component_id":"day","owner":"data_model","path":"/controls/day","property":"value","schema":"catalog.json#/components/ChoicePicker"},{"component_id":"hours","owner":"data_model","path":"/controls/hours","property":"value","schema":"catalog.json#/components/clio.slider.v1"},{"component_id":"plot","owner":"data_model","path":"/controls/day","property":"dataQuery/filter/0/value","schema":"catalog.json#/components/clio.chart.v1"},{"component_id":"plot","owner":"data_model","path":"/controls/hours","property":"dataQuery/filter/1/value","schema":"catalog.json#/components/clio.chart.v1"}],"data_model_messages":[{"updateDataModel":{"path":"/","surfaceId":"konza-burn-explorer","value":{"controls":{"day":["2022-04-15"],"hours":[8,20]}}},"version":"v0.9.1"},{"updateDataModel":{"path":"/controls/hours","surfaceId":"konza-burn-explorer","value":[16,17]},"version":"v0.9.1"},{"updateDataModel":{"path":"/controls","surfaceId":"konza-burn-explorer","value":{"day":["2022-04-16"],"hours":[9.75,10.25]}},"version":"v0.9.1"}],"revision":6,"surface_id":"konza-burn-explorer","viewers":[{"artifact_id":"","ready":true,"revision":6,"state":{"controls":[{"component":"ChoicePicker","component_id":"day","owner":"data_model","path":"/controls/day","property":"value","value":["2022-04-16"]},{"component":"clio.slider.v1","component_id":"hours","owner":"data_model","path":"/controls/hours","property":"value","value":[9.75,10.25]},{"component":"clio.chart.v1","component_id":"plot","owner":"data_model","path":"/controls/day","property":"dataQuery/filter/0/value","value":["2022-04-16"]},{"component":"clio.chart.v1","component_id":"plot","owner":"data_model","path":"/controls/hours","property":"d