s.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"properties\": {\n        \"component\": {\n          \"const\": \"clio.slider.v1\"\n        },\n        \"label\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"max\": {\n          \"type\": \"number\"\n        },\n        \"min\": {\n          \"type\": \"number\"\n        },\n        \"range\": {\n          \"type\": \"boolean\"\n        },\n        \"step\": {\n          \"type\": \"number\"\n        },\n        \"unit\": {\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"oneOf\": [\n            {\n              \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber\"\n            },\n            {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 2,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            }\n          ]\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"label\",\n        \"value\",\n        \"min\",\n        \"max\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A fractional-step numeric control, or a two-value range, with typed value boxes.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\n\n### Shared by catalog.json\n## Shared definitions (each referenced by name below, defined once for this call)\n\n### $defs/CatalogComponentCommon\n{\n  \"properties\": {\n    \"weight\": {\n      \"description\": \"Relative flex weight of this component inside a Row or Column. Only meaningful as a direct child of one.\",\n      \"type\": \"number\"\n    }\n  },\n  \"type\": \"object\"\n}\n\n### $defs/ChoiceOption\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"label\": {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n    },\n    \"value\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"label\",\n    \"value\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/DataQuery\n{\n  \"additionalProperties\": false,\n  \"description\": \"A server-side table query applied to dataUri: the table-query request body (POST /v1/artifacts/{id}/table-query) without format. The server runs filter, then aggregate, then downsample, then sort, then offset/limit. Omit columns to request every column of dataUri \\u2014 except alongside aggregate, where columns is required, since aggregate's output columns (e.g. price_mean) don't exist in the source and so cannot be inferred. limit bounds the rows in ONE response (a transfer size), not the underlying data; offset pages through a larger result across several requests. When a chart or map query would otherwise exceed limit without an explicit downsample, the server instead samples evenly across the full range and reports that it did, rather than silently truncating to the first rows. limit's own maximum here is a generous safety ceiling, not the deployment's real per-response cap, which is server-configured. A viewer (e.g. an interactive data-table) may layer its own user-driven paging/filtering/sorting on top of this dataQuery without replacing it \\u2014 the agent's own filter/aggregate/downsample intent still applies underneath. Shared verbatim by clio.chart.v1, clio.map.v1, and clio.data-table.v1.\",\n  \"if\": {\n    \"properties\": {\n      \"aggregate\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      }\n    },\n    \"required\": [\n      \"aggregate\"\n    ]\n  },\n  \"properties\": {\n    \"aggregate\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/QueryAggregate\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"columns\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/FieldName\"\n          },\n          \"maxItems\": 64,\n          \"minItems\": 1,\n          \"type\": \"array\",\n          \"uniqueItems\": true\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"downsample\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/QueryDownsample\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"filter\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/QueryFilter\"\n          },\n          \"maxItems\": 64,\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"limit\": {\n      \"anyOf\": [\n        {\n          \"maximum\": 50000,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"offset\": {\n      \"anyOf\": [\n        {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"sort\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/QuerySort\"\n          },\n          \"maxItems\": 64,\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    }\n  },\n  \"then\": {\n    \"required\": [\n      \"columns\"\n    ]\n  },\n  \"type\": \"object\"\n}\n\n### $defs/FieldName\n{\n  \"maxLength\": 128,\n  \"minLength\": 1,\n  \"type\": \"string\"\n}\n\n### $defs/GeoJsonGeometry\n{\n  \"description\": \"A GeoJSON Geometry object (RFC 7946 \\u00a73.1), strictly shaped: Point/MultiPoint/LineString/MultiLineString/Polygon/MultiPolygon carry coordinates; GeometryCollection carries geometries. Never a Feature/FeatureCollection, never a bare coordinate array.\",\n  \"oneOf\": [\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"type\": \"number\"\n          },\n          \"maxItems\": 3,\n          \"minItems\": 2,\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"Point\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"type\": \"number\"\n            },\n            \"maxItems\": 3,\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiPoint\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"type\": \"number\"\n            },\n            \"maxItems\": 3,\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"minItems\": 2,\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"LineString\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 3,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            },\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiLineString\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 3,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            },\n            \"minItems\": 4,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"Polygon\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"items\": {\n                  \"type\": \"number\"\n                },\n                \"maxItems\": 3,\n                \"minItems\": 2,\n                \"type\": \"array\"\n              },\n              \"minItems\": 4,\n              \"type\": \"array\"\n            },\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiPolygon\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"geometries\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/GeoJsonGeometry\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"GeometryCollection\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"geometries\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QueryAggregate\n{\n  \"additionalProperties\": false,\n  \"description\": \"Group rows by groupBy (empty or omitted: one global group) and reduce; each metric becomes a result column named {column}_{fn}, which must not repeat a groupBy column.\",\n  \"properties\": {\n    \"groupBy\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/FieldName\"\n      },\n      \"maxItems\": 64,\n      \"type\": \"array\",\n      \"uniqueItems\": true\n    },\n    \"metrics\": {\n      \"items\": {\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"column\": {\n            \"$ref\": \"#/$defs/FieldName\"\n          },\n          \"fn\": {\n            \"enum\": [\n              \"mean\",\n              \"min\",\n              \"max\",\n              \"count\",\n              \"sum\",\n              \"median\"\n            ],\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"column\",\n          \"fn\"\n        ],\n        \"type\": \"object\"\n      },\n      \"maxItems\": 64,\n      \"minItems\": 1,\n      \"type\": \"array\",\n      \"uniqueItems\": true\n    }\n  },\n  \"required\": [\n    \"metrics\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QueryDownsample\n{\n  \"additionalProperties\": false,\n  \"description\": \"How the server thins rows before limit applies. none keeps every row; stride keeps evenly spaced rows (per entityColumn up to maxPerEntity when set, else overall up to limit); per_entity_lttb runs LTTB on (x, y) per entityColumn (the whole table is one series without it) and needs x and y.\",\n  \"if\": {\n    \"properties\": {\n      \"mode\": {\n        \"const\": \"per_entity_lttb\"\n      }\n    },\n    \"required\": [\n      \"mode\"\n    ]\n  },\n  \"properties\": {\n    \"entityColumn\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"maxPerEntity\": {\n      \"default\": 500,\n      \"maximum\": 2000,\n      \"minimum\": 1,\n      \"type\": \"integer\"\n    },\n    \"mode\": {\n      \"default\": \"none\",\n      \"enum\": [\n        \"none\",\n        \"stride\",\n        \"per_entity_lttb\"\n      ],\n      \"type\": \"string\"\n    },\n    \"x\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"y\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    }\n  },\n  \"then\": {\n    \"properties\": {\n      \"x\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      },\n      \"y\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      }\n    },\n    \"required\": [\n      \"x\",\n      \"y\"\n    ]\n  },\n  \"type\": \"object\"\n}\n\n### $defs/QueryFilter\n{\n  \"additionalProperties\": false,\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"eq\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"type\": [\n                  \"string\",\n                  \"number\",\n                  \"boolean\"\n                ]\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"in\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"items\": {\n                  \"type\": [\n                    \"string\",\n                    \"number\",\n                    \"boolean\"\n                  ]\n                },\n                \"maxItems\": 10000,\n                \"minItems\": 1,\n                \"type\": \"array\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"range\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"items\": {\n                  \"type\": [\n                    \"string\",\n                    \"number\",\n                    \"boolean\",\n                    \"null\"\n                  ]\n                },\n                \"maxItems\": 2,\n                \"minItems\": 2,\n                \"type\": \"array\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"isnull\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"type\": [\n                  \"boolean\",\n                  \"null\"\n                ]\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        }\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"contains\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"minLength\": 1,\n                \"type\": \"string\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    }\n  ],\n  \"description\": \"One predicate; all filter entries are AND-ed. eq: value is a non-null scalar. in: value is a non-empty list of scalars. range: value is [min, max], inclusive, either side may be null. isnull: value omitted or true matches nulls, false matches non-nulls. contains: value is a non-empty string, matched as a case-insensitive substring of a string column (a per-column text filter).\",\n  \"properties\": {\n    \"column\": {\n      \"$ref\": \"#/$defs/FieldName\"\n    },\n    \"op\": {\n      \"enum\": [\n        \"eq\",\n        \"in\",\n        \"range\",\n        \"isnull\",\n        \"contains\"\n      ],\n      \"type\": \"string\"\n    },\n    \"value\": {}\n  },\n  \"required\": [\n    \"column\",\n    \"op\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QuerySort\n{\n  \"additionalProperties\": false,\n  \"description\": \"One dataQuery.sort key; earlier entries in the list sort first.\",\n  \"properties\": {\n    \"column\": {\n      \"$ref\": \"#/$defs/FieldName\"\n    },\n    \"desc\": {\n      \"default\": false,\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"column\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/SpecDataNamedSource\n{\n  \"description\": \"Every `data` key anywhere in a Vega-Lite spec is absent or exactly {\\\"name\\\": \\\"source\\\"} \\u2014 rows come from the component's data/dataUri, never the spec.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecDataNamedSource\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecDataNamedSource\"\n    },\n    \"properties\": {\n      \"data\": {\n        \"const\": {\n          \"name\": \"source\"\n        }\n      }\n    }\n  }\n}\n\n### $defs/SpecNoBindElement\n{\n  \"description\": \"No `element` key inside any `bind` object (params[].bind.element) anywhere in a Vega-Lite spec, at any depth \\u2014 it is a CSS selector that could mount a Vega input widget into any element on the host page, not just this chart.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecNoBindElement\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecNoBindElement\"\n    },\n    \"properties\": {\n      \"bind\": {\n        \"allOf\": [\n          {\n            \"if\": {\n              \"type\": \"object\"\n            },\n            \"then\": {\n              \"not\": {\n                \"required\": [\n                  \"element\"\n                ]\n              }\n            }\n          },\n          {\n            \"$ref\": \"#/$defs/SpecNoBindElement\"\n          }\n        ]\n      }\n    }\n  }\n}\n\n### $defs/SpecNoForbiddenKeys\n{\n  \"description\": \"No `url` or `usermeta` key anywhere in a Vega-Lite spec, at any depth.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecNoForbiddenKeys\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecNoForbiddenKeys\"\n    },\n    \"not\": {\n      \"anyOf\": [\n        {\n          \"required\": [\n            \"url\"\n          ]\n        },\n        {\n          \"required\": [\n            \"usermeta\"\n          ]\n        }\n      ]\n    }\n  }\n}","presentation":{"subject":"skill-name","summary":"","blocks":[{"id":"skill-name","type":"text","media_type":"","text":"a2ui-catalog-clio-workspace","label":"","language":"","workspace_id":"","path":"","sha256":"","pages":[],"uri":"","command":"","timed_out":false,"status":"","detail":"","items":[],"action_label":""},{"id":"content","type":"markdown","media_type":"","text":"=== File 1/6: catalog.json#/components/clio.chart.v1 ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"dependentRequired\": {\n        \"dataQuery\": [\n          \"dataUri\"\n        ]\n      },\n      \"properties\": {\n        \"colorField\": {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        \"component\": {\n          \"const\": \"clio.chart.v1\"\n        },\n        \"data\": {\n          \"description\": \"Inline rows (at most 10000) \\u2014 this array rides the surface's own wire message, so it is capped for transfer size; for a larger or growing dataset use dataUri instead, unbounded and paged/downsampled by the viewer. A cell is a scalar OR a strictly-shaped GeoJSON Geometry object ($defs/GeoJsonGeometry), so a geoshape mark can draw real shapes from inline rows.\",\n          \"items\": {\n            \"additionalProperties\": {\n              \"anyOf\": [\n                {\n                  \"type\": [\n                    \"string\",\n                    \"number\",\n                    \"boolean\",\n                    \"null\"\n                  ]\n                },\n                {\n                  \"$ref\": \"#/$defs/GeoJsonGeometry\"\n                }\n              ]\n            },\n            \"type\": \"object\"\n          },\n          \"maxItems\": 10000,\n          \"type\": \"array\"\n        },\n        \"dataQuery\": {\n          \"$ref\": \"#/$defs/DataQuery\"\n        },\n        \"dataUri\": {\n          \"description\": \"A workspace file path or artifact:// reference; CLIO registers a path as an artifact before validation.\",\n          \"not\": {\n            \"pattern\": \"\\\\s\"\n          },\n          \"pattern\": \"^artifact://artifact_[A-Za-z0-9_-]+$\",\n          \"type\": \"string\"\n        },\n        \"entityField\": {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        \"facetField\": {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        \"height\": {\n          \"maximum\": 2000,\n          \"minimum\": 80,\n          \"type\": \"number\"\n        },\n        \"preset\": {\n          \"enum\": [\n            \"trajectories\",\n            \"heatmap\",\n            \"spectra\",\n            \"boxplot\",\n            \"scatter\"\n          ],\n          \"type\": \"string\"\n        },\n        \"selection\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue\",\n          \"description\": \"Bind to /selection/<key>; the bound value is a SelectionState ({field, values[], source?}, see $defs/SelectionState). Components bound to the same path share one selection.\"\n        },\n        \"selectionField\": {\n          \"$ref\": \"#/$defs/FieldName\",\n          \"description\": \"Column used for an explicit selection binding. Ordinary views of one dataUri link by __row without this property; trajectory and spectra points select exact rows while entityField groups each curve.\"\n        },\n        \"selectionParam\": {\n          \"default\": \"sel\",\n          \"pattern\": \"^[A-Za-z_][A-Za-z0-9_]{0,63}$\",\n          \"type\": \"string\"\n        },\n        \"spec\": {\n          \"allOf\": [\n            {\n              \"$ref\": \"#/$defs/SpecNoForbiddenKeys\"\n            },\n            {\n              \"$ref\": \"#/$defs/SpecDataNamedSource\"\n            },\n            {\n              \"$ref\": \"#/$defs/SpecNoBindElement\"\n            }\n          ],\n          \"description\": \"A Vega-Lite spec whose rows come from data/dataUri as the named dataset 'source' \\u2014 the spec is chart configuration, never a data channel, and the dataset itself is unbounded via dataUri regardless of this cap. This schema already enforces the top-level key allowlist, no url/usermeta key at any depth, no bind.element at any depth (a CSS selector that could mount an input widget anywhere on the host page), and data only as {name: source} at any depth; the renderer additionally enforces the config-size (65536 bytes) and view-count (8) caps that keep the spec itself bounded and abuse-resistant, which JSON Schema cannot express. See a2ui/chart/guard_rules.json.\",\n          \"propertyNames\": {\n            \"enum\": [\n              \"$schema\",\n              \"mark\",\n              \"encoding\",\n              \"layer\",\n              \"facet\",\n              \"hconcat\",\n              \"vconcat\",\n              \"concat\",\n              \"repeat\",\n              \"spec\",\n              \"transform\",\n              \"params\",\n              \"width\",\n              \"height\",\n              \"title\",\n              \"resolve\",\n              \"config\",\n              \"autosize\",\n              \"description\",\n              \"columns\",\n              \"spacing\",\n              \"padding\",\n              \"align\",\n              \"bounds\",\n              \"center\",\n              \"projection\",\n              \"data\"\n            ]\n          },\n          \"type\": \"object\"\n        },\n        \"title\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"xField\": {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        \"xType\": {\n          \"enum\": [\n            \"temporal\",\n            \"quantitative\",\n            \"ordinal\"\n          ],\n          \"type\": \"string\"\n        },\n        \"yField\": {\n          \"$ref\": \"#/$defs/FieldName\"\n        }\n      },\n      \"required\": [\n        \"component\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"description\": \"Exactly one of spec or preset; preset fill fields need preset.\",\n      \"oneOf\": [\n        {\n          \"not\": {\n            \"anyOf\": [\n              {\n                \"required\": [\n                  \"preset\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"xField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"yField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"entityField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"colorField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"facetField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"xType\"\n                ]\n              }\n            ]\n          },\n          \"required\": [\n            \"spec\"\n          ]\n        },\n        {\n          \"not\": {\n            \"required\": [\n              \"spec\"\n            ]\n          },\n          \"required\": [\n            \"preset\"\n          ]\n        }\n      ]\n    },\n    {\n      \"description\": \"Exactly one of data or dataUri is required.\",\n      \"oneOf\": [\n        {\n          \"not\": {\n            \"required\": [\n              \"dataUri\"\n            ]\n          },\n          \"required\": [\n            \"data\"\n          ]\n        },\n        {\n          \"not\": {\n            \"required\": [\n              \"data\"\n            ]\n          },\n          \"required\": [\n            \"dataUri\"\n          ]\n        }\n      ]\n    },\n    {\n      \"description\": \"Fields used by the trajectories preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"trajectories\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the heatmap preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"heatmap\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"colorField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the spectra preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"spectra\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the boxplot preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"boxplot\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"not\": {\n          \"anyOf\": [\n            {\n              \"required\": [\n                \"facetField\"\n              ]\n            },\n            {\n              \"required\": [\n                \"xType\"\n              ]\n            }\n          ]\n        },\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the scatter preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"scatter\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    }\n  ],\n  \"description\": \"Any chart over tabular rows: a preset or an Altair/Vega-Lite spec.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue\n\n=== File 2/6: catalog.json#/components/Column ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"properties\": {\n        \"align\": {\n          \"enum\": [\n            \"start\",\n            \"center\",\n            \"end\",\n            \"stretch\"\n          ],\n          \"type\": \"string\"\n        },\n        \"children\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList\"\n        },\n        \"component\": {\n          \"const\": \"Column\"\n        },\n        \"justify\": {\n          \"enum\": [\n            \"start\",\n            \"center\",\n            \"end\",\n            \"spaceBetween\",\n            \"spaceAround\",\n            \"spaceEvenly\",\n            \"stretch\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"children\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A vertical layout container for child components.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList, https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\n\n=== File 3/6: catalog.json#/components/Text ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"properties\": {\n        \"component\": {\n          \"const\": \"Text\"\n        },\n        \"text\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"variant\": {\n          \"enum\": [\n            \"h1\",\n            \"h2\",\n            \"h3\",\n            \"h4\",\n            \"h5\",\n            \"caption\",\n            \"body\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"text\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A run of text, plain or headed (h1-h5, caption, body).\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\n\n=== File 4/6: catalog.json#/components/clio.callout.v1 ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"properties\": {\n        \"action\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action\"\n        },\n        \"body\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"component\": {\n          \"const\": \"clio.callout.v1\"\n        },\n        \"severity\": {\n          \"type\": \"string\"\n        },\n        \"title\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"title\",\n        \"body\",\n        \"severity\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A short flagged note distinct from plain text (info/warning/error severity).\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action, https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\n\n=== File 5/6: catalog.json#/components/ChoicePicker ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/Checkable\"\n    },\n    {\n      \"properties\": {\n        \"component\": {\n          \"const\": \"ChoicePicker\"\n        },\n        \"displayStyle\": {\n          \"enum\": [\n            \"checkbox\",\n            \"chips\"\n          ],\n          \"type\": \"string\"\n        },\n        \"filterable\": {\n          \"type\": \"boolean\"\n        },\n        \"label\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"options\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/ChoiceOption\"\n          },\n          \"type\": \"array\"\n        },\n        \"value\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicStringList\"\n        },\n        \"variant\": {\n          \"enum\": [\n            \"multipleSelection\",\n            \"mutuallyExclusive\"\n          ],\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"options\",\n        \"value\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A single- or multiple-selection picker; bind value to the path an action reads.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/Checkable, https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicStringList\n\n=== File 6/6: catalog.json#/components/clio.slider.v1 ===\n{\n  \"allOf\": [\n    {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon\"\n    },\n    {\n      \"$ref\": \"#/$defs/CatalogComponentCommon\"\n    },\n    {\n      \"properties\": {\n        \"component\": {\n          \"const\": \"clio.slider.v1\"\n        },\n        \"label\": {\n          \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n        },\n        \"max\": {\n          \"type\": \"number\"\n        },\n        \"min\": {\n          \"type\": \"number\"\n        },\n        \"range\": {\n          \"type\": \"boolean\"\n        },\n        \"step\": {\n          \"type\": \"number\"\n        },\n        \"unit\": {\n          \"type\": \"string\"\n        },\n        \"value\": {\n          \"oneOf\": [\n            {\n              \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber\"\n            },\n            {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 2,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            }\n          ]\n        }\n      },\n      \"required\": [\n        \"component\",\n        \"label\",\n        \"value\",\n        \"min\",\n        \"max\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"description\": \"A fractional-step numeric control, or a two-value range, with typed value boxes.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\n\n### Shared by catalog.json\n## Shared definitions (each referenced by name below, defined once for this call)\n\n### $defs/CatalogComponentCommon\n{\n  \"properties\": {\n    \"weight\": {\n      \"description\": \"Relative flex weight of this component inside a Row or Column. Only meaningful as a direct child of one.\",\n      \"type\": \"number\"\n    }\n  },\n  \"type\": \"object\"\n}\n\n### $defs/ChoiceOption\n{\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"label\": {\n      \"$ref\": \"https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString\"\n    },\n    \"value\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"label\",\n    \"value\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/DataQuery\n{\n  \"additionalProperties\": false,\n  \"description\": \"A server-side table query applied to dataUri: the table-query request body (POST /v1/artifacts/{id}/table-query) without format. The server runs filter, then aggregate, then downsample, then sort, then offset/limit. Omit columns to request every column of dataUri \\u2014 except alongside aggregate, where columns is required, since aggregate's output columns (e.g. price_mean) don't exist in the source and so cannot be inferred. limit bounds the rows in ONE response (a transfer size), not the underlying data; offset pages through a larger result across several requests. When a chart or map query would otherwise exceed limit without an explicit downsample, the server instead samples evenly across the full range and reports that it did, rather than silently truncating to the first rows. limit's own maximum here is a generous safety ceiling, not the deployment's real per-response cap, which is server-configured. A viewer (e.g. an interactive data-table) may layer its own user-driven paging/filtering/sorting on top of this dataQuery without replacing it \\u2014 the agent's own filter/aggregate/downsample intent still applies underneath. Shared verbatim by clio.chart.v1, clio.map.v1, and clio.data-table.v1.\",\n  \"if\": {\n    \"properties\": {\n      \"aggregate\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      }\n    },\n    \"required\": [\n      \"aggregate\"\n    ]\n  },\n  \"properties\": {\n    \"aggregate\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/QueryAggregate\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"columns\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/FieldName\"\n          },\n          \"maxItems\": 64,\n          \"minItems\": 1,\n          \"type\": \"array\",\n          \"uniqueItems\": true\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"downsample\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/QueryDownsample\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"filter\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/QueryFilter\"\n          },\n          \"maxItems\": 64,\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"limit\": {\n      \"anyOf\": [\n        {\n          \"maximum\": 50000,\n          \"minimum\": 1,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"offset\": {\n      \"anyOf\": [\n        {\n          \"minimum\": 0,\n          \"type\": \"integer\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"sort\": {\n      \"anyOf\": [\n        {\n          \"items\": {\n            \"$ref\": \"#/$defs/QuerySort\"\n          },\n          \"maxItems\": 64,\n          \"type\": \"array\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    }\n  },\n  \"then\": {\n    \"required\": [\n      \"columns\"\n    ]\n  },\n  \"type\": \"object\"\n}\n\n### $defs/FieldName\n{\n  \"maxLength\": 128,\n  \"minLength\": 1,\n  \"type\": \"string\"\n}\n\n### $defs/GeoJsonGeometry\n{\n  \"description\": \"A GeoJSON Geometry object (RFC 7946 \\u00a73.1), strictly shaped: Point/MultiPoint/LineString/MultiLineString/Polygon/MultiPolygon carry coordinates; GeometryCollection carries geometries. Never a Feature/FeatureCollection, never a bare coordinate array.\",\n  \"oneOf\": [\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"type\": \"number\"\n          },\n          \"maxItems\": 3,\n          \"minItems\": 2,\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"Point\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"type\": \"number\"\n            },\n            \"maxItems\": 3,\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiPoint\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"type\": \"number\"\n            },\n            \"maxItems\": 3,\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"minItems\": 2,\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"LineString\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 3,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            },\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiLineString\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"maxItems\": 3,\n              \"minItems\": 2,\n              \"type\": \"array\"\n            },\n            \"minItems\": 4,\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"Polygon\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"coordinates\": {\n          \"items\": {\n            \"items\": {\n              \"items\": {\n                \"items\": {\n                  \"type\": \"number\"\n                },\n                \"maxItems\": 3,\n                \"minItems\": 2,\n                \"type\": \"array\"\n              },\n              \"minItems\": 4,\n              \"type\": \"array\"\n            },\n            \"type\": \"array\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"MultiPolygon\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"coordinates\"\n      ],\n      \"type\": \"object\"\n    },\n    {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"geometries\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/GeoJsonGeometry\"\n          },\n          \"type\": \"array\"\n        },\n        \"type\": {\n          \"const\": \"GeometryCollection\"\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"geometries\"\n      ],\n      \"type\": \"object\"\n    }\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QueryAggregate\n{\n  \"additionalProperties\": false,\n  \"description\": \"Group rows by groupBy (empty or omitted: one global group) and reduce; each metric becomes a result column named {column}_{fn}, which must not repeat a groupBy column.\",\n  \"properties\": {\n    \"groupBy\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/FieldName\"\n      },\n      \"maxItems\": 64,\n      \"type\": \"array\",\n      \"uniqueItems\": true\n    },\n    \"metrics\": {\n      \"items\": {\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"column\": {\n            \"$ref\": \"#/$defs/FieldName\"\n          },\n          \"fn\": {\n            \"enum\": [\n              \"mean\",\n              \"min\",\n              \"max\",\n              \"count\",\n              \"sum\",\n              \"median\"\n            ],\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"column\",\n          \"fn\"\n        ],\n        \"type\": \"object\"\n      },\n      \"maxItems\": 64,\n      \"minItems\": 1,\n      \"type\": \"array\",\n      \"uniqueItems\": true\n    }\n  },\n  \"required\": [\n    \"metrics\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QueryDownsample\n{\n  \"additionalProperties\": false,\n  \"description\": \"How the server thins rows before limit applies. none keeps every row; stride keeps evenly spaced rows (per entityColumn up to maxPerEntity when set, else overall up to limit); per_entity_lttb runs LTTB on (x, y) per entityColumn (the whole table is one series without it) and needs x and y.\",\n  \"if\": {\n    \"properties\": {\n      \"mode\": {\n        \"const\": \"per_entity_lttb\"\n      }\n    },\n    \"required\": [\n      \"mode\"\n    ]\n  },\n  \"properties\": {\n    \"entityColumn\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"maxPerEntity\": {\n      \"default\": 500,\n      \"maximum\": 2000,\n      \"minimum\": 1,\n      \"type\": \"integer\"\n    },\n    \"mode\": {\n      \"default\": \"none\",\n      \"enum\": [\n        \"none\",\n        \"stride\",\n        \"per_entity_lttb\"\n      ],\n      \"type\": \"string\"\n    },\n    \"x\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    },\n    \"y\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/FieldName\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    }\n  },\n  \"then\": {\n    \"properties\": {\n      \"x\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      },\n      \"y\": {\n        \"not\": {\n          \"type\": \"null\"\n        }\n      }\n    },\n    \"required\": [\n      \"x\",\n      \"y\"\n    ]\n  },\n  \"type\": \"object\"\n}\n\n### $defs/QueryFilter\n{\n  \"additionalProperties\": false,\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"eq\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"type\": [\n                  \"string\",\n                  \"number\",\n                  \"boolean\"\n                ]\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"in\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"items\": {\n                  \"type\": [\n                    \"string\",\n                    \"number\",\n                    \"boolean\"\n                  ]\n                },\n                \"maxItems\": 10000,\n                \"minItems\": 1,\n                \"type\": \"array\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"range\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"items\": {\n                  \"type\": [\n                    \"string\",\n                    \"number\",\n                    \"boolean\",\n                    \"null\"\n                  ]\n                },\n                \"maxItems\": 2,\n                \"minItems\": 2,\n                \"type\": \"array\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"isnull\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"type\": [\n                  \"boolean\",\n                  \"null\"\n                ]\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        }\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"op\": {\n            \"const\": \"contains\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"value\": {\n            \"anyOf\": [\n              {\n                \"minLength\": 1,\n                \"type\": \"string\"\n              },\n              {\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"path\": {\n                    \"pattern\": \"^/\",\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"path\"\n                ],\n                \"type\": \"object\"\n              }\n            ]\n          }\n        },\n        \"required\": [\n          \"value\"\n        ]\n      }\n    }\n  ],\n  \"description\": \"One predicate; all filter entries are AND-ed. eq: value is a non-null scalar. in: value is a non-empty list of scalars. range: value is [min, max], inclusive, either side may be null. isnull: value omitted or true matches nulls, false matches non-nulls. contains: value is a non-empty string, matched as a case-insensitive substring of a string column (a per-column text filter).\",\n  \"properties\": {\n    \"column\": {\n      \"$ref\": \"#/$defs/FieldName\"\n    },\n    \"op\": {\n      \"enum\": [\n        \"eq\",\n        \"in\",\n        \"range\",\n        \"isnull\",\n        \"contains\"\n      ],\n      \"type\": \"string\"\n    },\n    \"value\": {}\n  },\n  \"required\": [\n    \"column\",\n    \"op\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/QuerySort\n{\n  \"additionalProperties\": false,\n  \"description\": \"One dataQuery.sort key; earlier entries in the list sort first.\",\n  \"properties\": {\n    \"column\": {\n      \"$ref\": \"#/$defs/FieldName\"\n    },\n    \"desc\": {\n      \"default\": false,\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"column\"\n  ],\n  \"type\": \"object\"\n}\n\n### $defs/SpecDataNamedSource\n{\n  \"description\": \"Every `data` key anywhere in a Vega-Lite spec is absent or exactly {\\\"name\\\": \\\"source\\\"} \\u2014 rows come from the component's data/dataUri, never the spec.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecDataNamedSource\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecDataNamedSource\"\n    },\n    \"properties\": {\n      \"data\": {\n        \"const\": {\n          \"name\": \"source\"\n        }\n      }\n    }\n  }\n}\n\n### $defs/SpecNoBindElement\n{\n  \"description\": \"No `element` key inside any `bind` object (params[].bind.element) anywhere in a Vega-Lite spec, at any depth \\u2014 it is a CSS selector that could mount a Vega input widget into any element on the host page, not just this chart.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecNoBindElement\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecNoBindElement\"\n    },\n    \"properties\": {\n      \"bind\": {\n        \"allOf\": [\n          {\n            \"if\": {\n              \"type\": \"object\"\n            },\n            \"then\": {\n              \"not\": {\n                \"required\": [\n                  \"element\"\n                ]\n              }\n            }\n          },\n          {\n            \"$ref\": \"#/$defs/SpecNoBindElement\"\n          }\n        ]\n      }\n    }\n  }\n}\n\n### $defs/SpecNoForbiddenKeys\n{\n  \"description\": \"No `url` or `usermeta` key anywhere in a Vega-Lite spec, at any depth.\",\n  \"else\": {\n    \"if\": {\n      \"type\": \"array\"\n    },\n    \"then\": {\n      \"items\": {\n        \"$ref\": \"#/$defs/SpecNoForbiddenKeys\"\n      }\n    }\n  },\n  \"if\": {\n    \"type\": \"object\"\n  },\n  \"then\": {\n    \"additionalProperties\": {\n      \"$ref\": \"#/$defs/SpecNoForbiddenKeys\"\n    },\n    \"not\": {\n      \"anyOf\": [\n        {\n          \"required\": [\n            \"url\"\n          ]\n        },\n        {\n          \"required\": [\n            \"usermeta\"\n          ]\n        }\n      ]\n    }\n  }\n}","label":"","language":"","workspace_id":"","path":"","sha256":"","pages":[],"uri":"","command":"","timed_out":false,"status":"","detail":"","items":[],"action_label":""}]},"duration_ms":276.1378288269043,"started_at":"2026-10-19T18:24:25.504794+00:00","completed_at":"2026-10-19T18:24:25.780932+00:00"},{"id":"call_386a9d9f52db","session_id":"sess_b1bbf58c66a5","run_id":"6dfdf0f1-d306-4446-aabc-81dcfcde0d00","name":"load_skill","title":"Load skill","state":"succeeded","input":{"kwargs":{"file":"references/discovery-and-analysis.md","files":null,"skill_id":"work-with-ndp"}},"output":"# Find, access and analyze scientific data\n\n## Discover an appropriate collection\n\nStart from the user's research question: phenomenon/variable, place or station,\ntime interval, resolution and desired output. Use known references and infer what\nthe context establishes; ask only for ambiguity that changes the selection.\n\n1. Inspect `connected_data_status` for approved resource selections and\n   `open_references`, catalogs in `ndp_catalogs`, and services in `ndp_endpoints`.\n2. Resolve a requested publisher with\n   `connected_data_ndp_organizations(query=\"earthscope\")`. Use its returned `id`\n   and `endpoint_id`, not a guessed organization slug.\n3. Search with `connected_data_search_ndp(query=..., organization=...,\n   endpoint_id=...)`. Query matches metadata, not every value in the underlying\n   data. Start broad enough to learn naming conventions, then refine using actual\n   station codes, titles, descriptions and formats.\n4. Inspect candidate resources. Distinguish measurement files, derived products,\n   images, notebooks, service descriptions and live/replay links. Check scientific\n   coverage; a familiar station name does not guarantee the requested variable or\n   time interval. Offer a small useful selection when there are several candidates.\n\nEach agent search page holds up to 50 datasets. Use the returned `next_offset`\nwith the same query/publisher/Endpoint, stopping when enough suitable data is found\nor pagination ends. Do not call the first page the entire catalog. Use total\ncounts as metadata, not proof that every resource is accessible. Catalog publishers\nare not account groups, and filtering by one does not grant protected access.\n\nUse central discovery for published collections. Use an approved Endpoint's local\ncatalog for unpublished/local holdings or services. If central search fails,\ndiagnose its actual error and narrow/retry as appropriate; a local catalog is a\ndifferent scope, not a transparent substitute. Don't scan every Endpoint or\ndownload a whole collection just to populate choices.\n\n## Attach only the selected resources\n\nUse actual returned IDs:\n\nA source contains exactly its selected resources, not every resource in the\ndataset. If another measurement or README is needed, connect that returned\nresource set and use the new connection's source ID. An existing source for the\nsame dataset may contain a different selection; a missing selected path is not\nan upstream availability failure.\n\n```text\nconnected_data_connect(\n  provider=\"ndp\", root=DATASET_ID, label=DATASET_TITLE, mode=\"read_only\",\n  configuration={\"endpoint_id\": CATALOG_ENDPOINT_ID,\n                 \"resource_ids\": [SELECTED_RESOURCE_ID]})\n```\n\n`CATALOG_ENDPOINT_ID` comes from the dataset search. It is not necessarily a saved\nservice connection ID. Public data can work without sign-in. If sign-in is needed,\nfollow `connect-data` and the saved NDP account's private `login_action`; after the\nuser returns, recheck status and retry the same connection. An account can be\nconnected while a particular resource still denies access. Report observed\nissuer/role errors without inferring or changing group membership.\n\nConnection starts indexing, not a full download. Wait using the durable task handle\nand normal task result tools. Then `connected_data_open(source_id=SOURCE_ID)` lists\napproved relative paths (200 per page). Retain attachment `revision`, `linked` and\n`folder` when supplied; pass them back on listing/reads so a changed selection\ncannot silently substitute a different revision.\n\nThe completed index supplies the linked manifest; it has not fetched file bodies.\nKeep `linked=true` for this index. Do not switch to `linked=false` until a Download\nhas completed, and do not pass the linked revision to a downloaded read. To read\nthrough the link, open the selected path\nwith `connected_data_open(source_id=SOURCE_ID, path=RELATIVE_PATH, ...)`.\nUse its immutable `resource_id` with\n`workspace_resource_read` or `workspace_resource_inspect`. Linked paths are virtual\nreferences, not shell mounts.\n\n## Materialize and analyze\n\nFor Python or shell analysis use\n`connected_data_download(source_id=SOURCE_ID, selected_paths=[RELATIVE_PATH])`.\nWait for completion and use the returned materialized path. Do not guess a source\nfolder path or resubmit an accepted download. NDP originals stay intact; create\nseparate derivatives in the workspace. A downloaded historical copy is not a\ncurrent upstream read after disconnection.\n\nDownloads stream in bounded chunks with an 8 GiB ceiling per resource. Capacity,\ncancellation and complete-snapshot publication belong to the transfer task; its\nsuccess does not mean the file was loaded into the model or into RAM. Linked-file\nreads retain their separate 512 MiB ceiling. Use a download for a larger approved\nresource, then inspect its format and process it incrementally. Preserve only the\nneeded columns, intervals and aggregates rather than constructing an unbounded\ndataframe. A transfer-limit error is a CLIO size limit, not an NDP access denial.\n\nUse the returned downloaded input path directly for reads, even when CLIO stores\nit outside the workspace root. Shell `access_paths` requests broader folder\npermissions; it is not needed to read these approved inputs and cannot authorize\nwrites to protected source snapshots. Keep scripts, outputs and temporary work\nunder the workspace. If selected measurements lack the necessary coverage, inspect\nalternative resources in the collection before treating that as a collection-wide\ngap. Record exactly which instruments and intervals were examined.\n\nChoose analysis from actual data, not format assumptions:\n\n| Data | Checks before computing |\n| --- | --- |\n| Time series | Measurement time vs capture time, timezone/epoch encoding, cadence, gaps, duplicates, component names and units. GNSS components may differ in scaling and reference frame. |\n| Instrument log / packet archive | A stored record may contain zero, one or several measurement frames. Inspect framing and device timestamps; retain complete frames and diagnose duplicates/truncation. Envelope/readout time and record count are not automatically measurement time and sample count. |\n| HDF5 / NetCDF / array output | Group/variable names, dimensions, coordinate conventions, units, fill values, chunking and requested subset. Inspect metadata before reading an entire large array. |\n| Spatial/station records | Coordinate reference, channel/network/station identifiers, geometry and station epochs. Metadata rows are not waveform or displacement samples. |\n| Service or stream response | Actual payload schema, status/control events, measurement timestamps and whether data is replay or current acquisition. See `services-and-streams.md`. |\n\nRepeated measurement fields can represent successive frames, not duplicate\nmetadata keys. Do not silently reduce them to the first or last value in a\ndictionary. State which clock and observation unit an aggregate uses, and verify\nthe logical sample counts before aligning instruments or interpreting missing\nobservations.\n\nUse existing installed readers and the relevant analysis/visualization skills;\ndon't execute downloaded notebooks or deserialize executable objects merely to\nread measurements. Preserve input dataset/resource IDs, source revision and content\nhashes, query filters, units and transformations with the results. Register useful\nreports, tables and figures as artifacts, and visually inspect figures before\ncalling them reviewed. The user may need only a comparison, not a dashboard.\n\n## Interpret failures\n\n- **No matches:** broaden terms, inspect publisher naming and coverage, then refine.\n  Distinguish an empty successful result from a failed search.\n- **503 / timeout:** preserve the query and actual error; bounded retry or narrower\n  paging can help. Do not report an empty catalog or reconnect the account as a\n  generic remedy for a server outage.\n- **Sign-in required / 401 / 403:** separate saved account state, destination/issuer\n  compatibility and resource/Endpoint authorization. Successful browser SSO alone\n  is not the private CLIO grant.\n- **Only a preview/service link:** explain what it supplies and follow the service\n  route when needed. Do not manufacture a data-file URL from its filename.\n- **Partial download or changed revision:** inspect the accepted task's result and\n  exact source identity. Keep verified files; resolve the changed input before\n  claiming the full selection was analyzed.\n\nFinish with the scientific result, selected collection/coverage and usable output\nartifacts. Separate found metadata, obtained bytes and checked analysis in the\nevidence; none substitutes for the next.\n","presentation":{"subject":"skill-name","summary":"","blocks":[{"id":"skill-name","type":"text","media_type":"","text":"work-with-ndp","label":"","language"