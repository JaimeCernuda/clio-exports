             {\n                \"required\": [\n                  \"colorField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"facetField\"\n                ]\n              },\n              {\n                \"required\": [\n                  \"xType\"\n                ]\n              }\n            ]\n          },\n          \"required\": [\n            \"spec\"\n          ]\n        },\n        {\n          \"not\": {\n            \"required\": [\n              \"spec\"\n            ]\n          },\n          \"required\": [\n            \"preset\"\n          ]\n        }\n      ]\n    },\n    {\n      \"description\": \"Exactly one of data or dataUri is required.\",\n      \"oneOf\": [\n        {\n          \"not\": {\n            \"required\": [\n              \"dataUri\"\n            ]\n          },\n          \"required\": [\n            \"data\"\n          ]\n        },\n        {\n          \"not\": {\n            \"required\": [\n              \"data\"\n            ]\n          },\n          \"required\": [\n            \"dataUri\"\n          ]\n        }\n      ]\n    },\n    {\n      \"description\": \"Fields used by the trajectories preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"trajectories\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the heatmap preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"heatmap\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"colorField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the spectra preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"spectra\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the boxplot preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"boxplot\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"not\": {\n          \"anyOf\": [\n            {\n              \"required\": [\n                \"facetField\"\n              ]\n            },\n            {\n              \"required\": [\n                \"xType\"\n              ]\n            }\n          ]\n        },\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    },\n    {\n      \"description\": \"Fields used by the scatter preset.\",\n      \"if\": {\n        \"properties\": {\n          \"preset\": {\n            \"const\": \"scatter\"\n          }\n        },\n        \"required\": [\n          \"preset\"\n        ]\n      },\n      \"then\": {\n        \"required\": [\n          \"xField\",\n          \"yField\",\n          \"entityField\"\n        ]\n      }\n    }\n  ],\n  \"description\": \"Any chart over tabular rows: a preset or an Altair/Vega-Lite spec.\",\n  \"type\": \"object\",\n  \"unevaluatedProperties\": false\n}\n\nStandard refs (not loadable here): https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString, https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue\n\n=== File 3/4: