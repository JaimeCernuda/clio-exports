45.030365+00:00","completed_at":"2026-10-19T07:13:46.350359+00:00"},{"id":"call_3d614552cd3a","session_id":"sess_9cca40f4085e","run_id":"2a8625f6-7d4f-4c6e-953a-06473215e6a3","name":"create_artifact","title":"Create Artifact","state":"succeeded","input":{"annotation":"Scale-sensitivity results, complete comparison table, metric simplification/geodesic measurement method and source caveats.","artifacts":null,"content":"# Lake Tahoe shoreline length depends on retained detail\n\n## Finding\n\nThe original NDP/TRPA boundary has a WGS84 geodesic perimeter of **123.049623 km (76.459491 miles)**. Progressively simplifying this same polygon produces **112.671601 km at 100 m tolerance** (8.434% shorter) and **101.999834 km at 1,000 m tolerance** (17.107% shorter). The original is 21.050 km longer than the 1,000 m version. These percentages use the original boundary as the denominator.\n\n| Simplification tolerance (m) | Shoreline (km) | Shorter than original (%) | Vertices, excluding closing duplicate |\n|---:|---:|---:|---:|\n| 0 — original, no simplification | 123.050 | 0.000 | 20,471 |\n| 1 | 122.702 | 0.282 | 5,219 |\n| 5 | 121.629 | 1.155 | 1,790 |\n| 10 | 120.582 | 2.005 | 1,101 |\n| 25 | 118.137 | 3.992 | 515 |\n| 50 | 115.898 | 5.812 | 288 |\n| 100 | 112.672 | 8.434 | 146 |\n| 250 | 109.214 | 11.244 | 68 |\n| 500 | 105.340 | 14.392 | 38 |\n| 1,000 | 102.000 | 17.107 | 22 |\n\nAt 100 m tolerance, enclosed area changes by -0.171%, compared with -8.434% for shoreline length. This shows why the earlier area estimate was much less sensitive to fine bends. At 1,000 m tolerance the area changes by -2.594%; coarse generalization eventually affects both quantities.\n\n## What “resolution” means here\n\nThis is a controlled **vector-simplification tolerance** experiment, not a comparison of independent maps or satellite pixel sizes. A larger tolerance permits larger departures from the original polyline when removing bends. It does not mean equal vertex spacing, ruler step length, or known survey accuracy. A value of 0 means the stored boundary was used unchanged; it is not infinite spatial resolution. Simply zooming the same map does not change the length calculated from its coordinates.\n\n## Reproducible method\n\n1. Reused the exact retained GeoJSON from the previous area calculation, with SHA-256 `bf1d07bac1af2b520ba21963b30048f1f8231c8882b86f8923b3f963ca641154`. NDP dataset `f8e23062-bc48-4bdd-9698-374bee3712fd`; resource `6c62c1d6-bce0-4ee1-bd9c-8b55fd3f1eee`. Publisher: TRPA. One valid Polygon, no interior rings; `OBJECTID=410`. CRS84 longitude/latitude coordinate order.\n2. Projected all vertices to local WGS84 azimuthal equidistant coordinates in metres: `+proj=aeqd +lat_0=39.1 +lon_0=-120 +datum=WGS84 +units=m`. This projection is used to define local metric simplification tolerances, not as the final length estimator.\n3. For each positive tolerance, independently simplified the original projected polygon with Shapely `simplify(tolerance, preserve_topology=True)` (Douglas–Peucker-based topology-preserving simplification). No cumulative simplification, rasterization, smoothing, or new source information was used. Original ring ordering/start was retained. Every output was checked to remain a valid Polygon without holes.\n4. Transformed retained vertices back to WGS84 and summed shortest ellipsoidal geodesic distances along the closed exterior ring with `pyproj.Geod(ellps='WGS84').geometry_length`. Included the closing segment. No island shorelines were added.\n5. Calculated reduction as `100 * (original_length - simplified_length) / original_length`. Vertex counts omit the duplicated closing coordinate. The CSV retains full computational precision; rounded results do not imply matching real-world accuracy.\n\nSoftware: Shapely 2.2.0; pyproj 3.8.0; GEOS version recorded in `analysis.json`. The companion package includes a portable script, original boundary, result CSV/JSON, all simplified shorelines as GeoJSON, publisher metadata and the comparison figure.\n\n## Visual interpretation\n\nThe interactive chart uses a logarithmic tolerance axis for 1–1,000 m and a 100–125 km vertical range (not a zero-origin axis). The dashed horizontal line marks the unsimplified 123.05 km reference; zero tolerance is shown in the table, not on the logarithmic axis. Point connections guide the eye and are not interpolated new measurements.\n\nThe three-panel figure shows the same southwest-shore window (approximately 120.122–120.072° W, 38.943–38.974° N). Grey is the unsimplified boundary and colour is the simplified version; whole-lake length labels must not be interpreted as lengths inside that window. All panels use the same projected bounds and scale. Scale bars are local projected distances.\n\n## Limits\n\nThis is sensitivity to one generalization algorithm and tolerance convention, not a statistical confidence interval or a universal shoreline length. The trend illustrates the coastline/shoreline paradox: finer representations follow more bends and generally give longer perimeters. This test does not demonstrate a fractal dimension or extrapolate beyond the stored geometry. The source has finite mapped detail and may include digitization noise. Its median segment spacing is 4.214 m (range 0.182–108.452 m), which is not evidence of 4 m positional accuracy.\n\nThe [TRPA layer](https://maps.trpa.org/server/rest/services/Datadownloader_SoilsandHydro/MapServer/1) is described as “Lake Tahoe boundary delineation.” The retained publisher metadata does not specify survey accuracy, a shoreline survey date, or a water-level reference. These are mapped horizontal shoreline estimates, not today's surveyed shoreline, a three-dimensional terrain-following length, or a length including unencoded island shores.\n","kind":"report","name":"D:\\CLIO-Develop\\ndp-shareable-20261019\\tahoe-boundary-18\\tahoe-shoreline\\shoreline_method.md","path":"","pdf_preview":null,"purpose":"deliverable","used":["artifact_abefccf4dce84036aeed26dbb0d35481","D:\\CLIO-Develop\\ndp-shareable-20261019\\tahoe-boundary-18\\tahoe-shoreline\\analysis.json","D:\\CLIO-Develop\\ndp-shareable-20261019\\tahoe-boundary-18\\tahoe-area\\layer_metadata.xml"]},"output":{"artifacts":[{"accepted":true,"artifact_id":"artifact_08691ac1aeea49eabee0be90bfea19ba","created":true,"custody":"cas","kind":"report","mechanism":"model","name":"shoreline_method.md","reason":"","sha256":"d05cf25f7e51e9e66cadb8c97709a0528be79c617232292c7e2009a7b575d63b","version":1}],"created":1,"deduplicated":0,"pdf_previews":[],"promotion_budget":{"limit":8,"remaining":5,"used":3},"rejected":0},"presentation":{"action":"Create Artifact","subject":"artifact-0","summary":"Created version 1","blocks":[{"id":"artifact-0","type":"link","media_type":"","text":"","label":"shoreline_method.md","language":"","workspace_id":"","path":"","sha256":"","pages":[],"target":"artifact","uri":"artifact_08691ac1aeea49eabee0be90bfea19ba","command":"","timed_out":false,"status":"","detail":"","items":[],"action_label":""}]},"duration_ms":1640.861988067627,"started_at":"2026-10-19T07:13:45.123089+00:00","completed_at":"2026-10-19T07:13:46.763951+00:00"},{"id":"call_d7a38dae0cb7","session_id":"sess_9cca40f4085e","run_id":"2a8625f6-7d4f-4c6e-953a-06473215e6a3","name":"capture_a2ui_surface","title":"Inspect rendered widget","state":"succeeded","input":{"artifact_id":"","component_id":"","expected_revision":2,"expected_view_revision":7,"surface_id":"tahoe-shoreline-resolution","timeout_seconds":20.0,"viewer_id":"17848bc5-3480-4c9e-bf19-929ba993d6b2"},"output":{"artifact_id":"artifact_e3deffa00fe643db9b3b904e4f61e7d1","capture":{"component_id":"","height":689,"request_id":"aa173c28e56441a989a5c288de53472c","viewer":{"artifact_id":"","ready":true,"revision":2,"state":{"controls":[],"data_views":[{"component_id":"length","reference":{"markdown":"**Coarser detail → shorter shoreline**\nDataset: artifact_abefccf4dce84036aeed26dbb0d35481.\n\nZone: the filtered current view (